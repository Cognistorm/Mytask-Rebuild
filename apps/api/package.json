{
  "name": "@mytask/api",
  "version": "0.1.0",
  "private": true,
  "description": "MyTask.ge API: NestJS HTTP + realtime (main.ts) and worker (worker.ts). All business logic lives here (architecture §1).",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && concurrently -k -n api,worker \"nest start --watch --preserveWatchOutput\" \"node scripts/dev-worker.mjs\"",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setting:set": "node scripts/set-setting.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-presigned-post": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@mytask/i18n": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express-openapi-validator": "5.6.2",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.13",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "ua-parser-js": "1.0.41",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "@mytask/config": "workspace:*",
    "@mytask/types": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "ioredis-mock": "8.13.1",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
