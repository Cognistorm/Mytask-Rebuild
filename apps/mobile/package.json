{
  "name": "@mytask/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "MyTask.ge iOS + Android app (React Native + Expo Router). Same API, tokens and i18n as the web (ADR-001).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@mytask/api-client": "workspace:*",
    "@mytask/i18n": "workspace:*",
    "@mytask/tokens": "workspace:*",
    "@mytask/types": "workspace:*",
    "expo": "57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@mytask/config": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "eslint": "10.11.0",
    "typescript": "5.9.3"
  }
