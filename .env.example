# MyTask.ge environment variables — NAMES ONLY (CLAUDE.md rule 8, ADR-013 §8).
# Copy to `.env` (git-ignored) and fill in, or run `pnpm setup:env`. Local values for `pnpm local` (no Docker,
# ADR-020) are described in docs/SETUP-LOCAL.md. Never commit real keys. Variables marked (later: slice NN) are not read yet.

# --- Runtime --------------------------------------------------------------------------------------
# development | test | production
NODE_ENV=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=
# Public URLs of the web app and the admin app (e.g. http://localhost:3100, http://localhost:3200)
APP_URL=
ADMIN_URL=

# --- API process ------------------------------------------------------------------------------------
# HTTP port of the API (default 3000) and its internal readiness port (default 3001; never public)
PORT=
# Interface of the API (default 127.0.0.1: this computer only). Set 0.0.0.0 only to test the app on a phone
# (SETUP-LOCAL §4), and remove it afterwards: the API is then reachable from the whole Wi-Fi (SEC-71)
HOST=
READINESS_PORT=
# Internal readiness port of the worker (default 3002)
WORKER_READINESS_PORT=
# Interface of both readiness servers (default 127.0.0.1; set 0.0.0.0 only if a probe outside the container needs it)
READINESS_HOST=
# Optional: path to docs/04-api/openapi.yaml (containers set it; locally it is found automatically)
OPENAPI_SPEC_PATH=
# Optional: true|false. Response validation against the contract (default: on except in production)
OPENAPI_VALIDATE_RESPONSES=
# API tests only; must be false/empty in production (ADR-002 §2)
STAFF_BODY_TOKENS_ENABLED=

# --- PostgreSQL ---------------------------------------------------------------------------------------
# Used by docker compose to create the local database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# postgresql://USER:PASSWORD@HOST:5432/DB (host: localhost with pnpm dev, postgres inside compose)
DATABASE_URL=

# --- Redis --------------------------------------------------------------------------------------------
# redis://HOST:6379 (localhost with pnpm dev, redis inside compose)
REDIS_URL=

# --- Object storage (S3 API; SeaweedFS locally, ADR-017) --------------------------------------
S3_ENDPOINT=
# Only when browsers/apps reach storage at another address than the API (compose sets http://localhost:8333).
# The web app also reads it: its CSP lets browsers upload to this origin (connect-src).
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_BUCKET_KYC=
# Base URL of the public images (avatars, portfolio). The web app also reads it: its CSP allows this origin (img-src).
PUBLIC_MEDIA_BASE_URL=

# --- Client IP chain (ADR-013 §14–§19) -----------------------------------------------------------------
# Caddy's fixed address(es) on the edge network, comma-separated (compose: 172.30.0.10). Empty without Caddy.
TRUSTED_PROXY_IPS=
# Random secret, >= 256 bits (e.g. `openssl rand -hex 32`); web/admin SSR -> API visitor-IP credential (§17)
INTERNAL_SERVICE_TOKEN=
# Staging/production only: file with Cloudflare's IP ranges (§14)
CLOUDFLARE_IP_RANGES_FILE=

# --- Web / admin / mobile --------------------------------------------------------------------------------
# Next.js server-side calls to the API on the internal network (e.g. http://localhost:3000/api/v1, http://api:3000/api/v1)
API_INTERNAL_URL=
# Local `pnpm dev` only: where Next forwards browser /api/v1 calls (default http://localhost:3000)
API_DEV_PROXY_ORIGIN=
# Mobile app: API address reachable from the phone (e.g. http://192.168.1.20:3000/api/v1)
EXPO_PUBLIC_API_URL=

# --- Auth (later: slice 01) ------------------------------------------------------------------------------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SETTINGS_ENCRYPTION_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Email (later: slice 01/15). Locally SMTP_URL points at Mailpit (smtp://localhost:1025) -----------
SMTP_URL=
# smtp (default) | log = print emails in the worker console (local preview only; refused in production)
MAIL_TRANSPORT=
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
UNSUBSCRIBE_TOKEN_KEY=

# --- Payments, BOG (later: slice 05). Locally BOG_API_BASE_URL points at tools/bog-mock ----------------
BOG_API_BASE_URL=
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_CALLBACK_PUBLIC_KEY=
BOG_CALLBACK_URL=

# --- Other integrations (later) ---------------------------------------------------------------------------
# Expo push (slice 15)
EXPO_ACCESS_TOKEN=
# Local GeoIP database licence (ADR-012)
GEOIP_LICENSE_KEY=
# Virus scan of uploads (ADR-009 §6). `clamav` needs CLAMAV_HOST; `none` = files marked scan_skipped
# (local only; production needs a scanner unless the Owner approves `none`). Empty = clamav if
# CLAMAV_HOST is set, else none. `pnpm local` (no Docker, ADR-020) uses none: there is no ClamAV locally.
SCAN_PROVIDER=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Signed outbound links (spec 17)
OUTBOUND_LINK_SIGNING_KEY=
# Error tracking DSNs (optional, off locally)
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_ADMIN=
SENTRY_DSN_MOBILE=
