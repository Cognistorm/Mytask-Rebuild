{
  "$description": "MyTask.ge design tokens: the single source of truth for web (CSS variables), admin (CSS variables) and mobile (React Native theme object). Format: W3C Design Tokens (DTCG) style, see docs/05-design/tokens.md section 2. Only the ui-ux-designer changes this file.",
  "$metadata": {
    "name": "@mytask/tokens",
    "version": "0.1.0",
    "status": "proposal (P2-C2, 2026-09-28), awaiting Owner approval with the preview page (P2-C3)",
    "units": "Every dimension is a plain number in px (CSS: px; React Native: density-independent points). Durations are numbers in ms. Colours are #RRGGBB or #RRGGBBAA.",
    "references": "A string value '{a.b.c}' is an alias to the token at path a.b.c (absolute path from the root of this file).",
    "themes": "theme.light is the default (Owner Q-059). theme.dark is the only other theme. Components use theme.* role tokens only, never the primitive palette directly."
  },

  "color": {
    "$type": "color",
    "$description": "Primitive palette. Do not use these in components; use theme.<light|dark>.* roles.",
    "brand": {
      "$description": "Teal. Anchored on the four teals that already exist in the brand: 500 = live primary, 600 = live hero, 700 = logo 'M', 900 = logo 'S/K'.",
      "50":  { "$value": "#EFF8F8" },
      "100": { "$value": "#D6EFEE" },
      "200": { "$value": "#AEDFDD" },
      "300": { "$value": "#7FCAC7" },
      "400": { "$value": "#52B3B0" },
      "500": { "$value": "#35A29F", "$description": "Legacy live --color-primary. Accent only (3.08:1 with white): large text, icons, illustrations, chips. Never white text on it, never body text on white (Q-073)." },
      "600": { "$value": "#29807E", "$description": "Legacy home hero background. Hero surface and light-theme focus ring." },
      "700": { "$value": "#0D696C", "$description": "Logo teal. Primary action and link colour in light theme (6.45:1 with white, Q-073)." },
      "800": { "$value": "#08565A", "$description": "Primary hover." },
      "900": { "$value": "#024249", "$description": "Logo deep teal. Primary pressed." },
      "950": { "$value": "#012C31" }
    },
    "neutral": {
      "$description": "One neutral ramp replacing Tailwind gray + zinc + slate and 77 hex greys (audit 1.2). Based on zinc (the legacy dark palette) with 450/500 tuned for contrast and 750-950 for the dark theme.",
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#FAFAFA", "$description": "Legacy page background (main-app bg-[#fafafa])." },
      "100": { "$value": "#F4F4F5" },
      "200": { "$value": "#E4E4E7" },
      "300": { "$value": "#D4D4D8" },
      "400": { "$value": "#A1A1AA", "$description": "Dark theme muted text. Light theme: disabled text and decorative only (2.56:1 on white)." },
      "450": { "$value": "#8A8A93", "$description": "Form-control borders in both themes (>= 3:1 non-text contrast)." },
      "500": { "$value": "#6B6B74", "$description": "Light muted text (tuned from zinc-500 #71717A so it passes on neutral-100 too)." },
      "600": { "$value": "#52525B" },
      "700": { "$value": "#3F3F46" },
      "750": { "$value": "#36363B" },
      "800": { "$value": "#2E2E33" },
      "850": { "$value": "#27272A", "$description": "Legacy dark card (zinc-800)." },
      "900": { "$value": "#1E1E21" },
      "950": { "$value": "#161616", "$description": "Legacy dark page background." }
    },
    "orange": {
      "$description": "Logo 'A' orange. Promotional accent: Featured/Top badge, Premium frame, invite banner, accent button. Always with dark text (Q-078).",
      "50":  { "$value": "#FFF5ED" },
      "100": { "$value": "#FFE6D3" },
      "200": { "$value": "#FDCBA6" },
      "300": { "$value": "#F9A76E" },
      "400": { "$value": "#F48438", "$description": "Logo 'A'." },
      "500": { "$value": "#E56F1F" },
      "600": { "$value": "#C2560F" },
      "700": { "$value": "#A1450C" },
      "800": { "$value": "#8A3A0B" },
      "900": { "$value": "#6B2D0A" },
      "950": { "$value": "#3D1804" }
    },
    "coral": {
      "$description": "Logo 'T' coral. Decorative accent only: favourite heart (filled), illustrations. Never text.",
      "100": { "$value": "#FCE7E3" },
      "300": { "$value": "#EE9F90" },
      "400": { "$value": "#E16A54", "$description": "Logo 'T'." },
      "500": { "$value": "#CB5540" },
      "800": { "$value": "#8F2F1F" }
    },
    "green": {
      "$description": "Success. A true green so success never looks like the teal brand (audit 1.3: legacy success was teal-600).",
      "50":  { "$value": "#F0FDF4" },
      "100": { "$value": "#DCFCE7" },
      "200": { "$value": "#BBF7D0" },
      "300": { "$value": "#86EFAC" },
      "400": { "$value": "#4ADE80" },
      "500": { "$value": "#22C55E" },
      "600": { "$value": "#16A34A" },
      "700": { "$value": "#15803D" },
      "800": { "$value": "#166534" },
      "900": { "$value": "#14532D" },
      "950": { "$value": "#052E16" }
    },
    "amber": {
      "$description": "Warning and rating stars.",
      "50":  { "$value": "#FFFBEB" },
      "100": { "$value": "#FEF3C7" },
      "200": { "$value": "#FDE68A" },
      "300": { "$value": "#FCD34D" },
      "400": { "$value": "#FBBF24" },
      "500": { "$value": "#F59E0B" },
      "600": { "$value": "#D97706" },
      "700": { "$value": "#B45309" },
      "800": { "$value": "#92400E" },
      "900": { "$value": "#78350F" },
      "950": { "$value": "#451A03" }
    },
    "red": {
      "$description": "Danger / error. 700 = legacy --danger #B91C1C.",
      "50":  { "$value": "#FEF2F2" },
      "100": { "$value": "#FEE2E2" },
      "200": { "$value": "#FECACA" },
      "300": { "$value": "#FCA5A5" },
      "400": { "$value": "#F87171" },
      "500": { "$value": "#EF4444" },
      "600": { "$value": "#DC2626" },
      "700": { "$value": "#B91C1C" },
      "800": { "$value": "#991B1B" },
      "900": { "$value": "#7F1D1D" },
      "950": { "$value": "#450A0A" }
    },
    "blue": {
      "$description": "Info, and the Buying role colour (legacy buyer dashboard blue-50/700).",
      "50":  { "$value": "#EFF6FF" },
      "100": { "$value": "#DBEAFE" },
      "200": { "$value": "#BFDBFE" },
      "300": { "$value": "#93C5FD" },
      "400": { "$value": "#60A5FA" },
      "500": { "$value": "#3B82F6" },
      "600": { "$value": "#2563EB" },
      "700": { "$value": "#1D4ED8" },
      "800": { "$value": "#1E40AF" },
      "900": { "$value": "#1E3A8A" },
      "950": { "$value": "#172554" }
    },
    "alpha": {
      "$description": "Translucent colours for scrims and image overlays.",
      "scrimLight": { "$value": "#16161680", "$description": "Modal/sheet backdrop, light theme (50%)." },
      "scrimDark":  { "$value": "#000000B3", "$description": "Modal/sheet backdrop, dark theme (70%)." },
      "imageGradientStart": { "$value": "#16161600" },
      "imageGradientEnd":   { "$value": "#161616CC", "$description": "Bottom of the category tile gradient (legacy black gradient). White title on it: >= 4.5:1 guaranteed where text sits." },
      "white12": { "$value": "#FFFFFF1F" },
      "black08": { "$value": "#16161614" }
    },
    "social": {
      "$description": "Third-party brand colours. The ONLY exception to 'brand palette only'. Used for share/login buttons as icon colour or with their own brand-approved text colour.",
      "facebook": { "$value": "#1877F2" },
      "linkedin": { "$value": "#0A66C2" },
      "whatsapp": { "$value": "#25D366" },
      "x":        { "$value": "#000000" },
      "google":   { "$value": "#4285F4" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["FiraGO", "Noto Sans Georgian", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "FiraGO (SIL OFL 1.1, v1.001): Mkhedruli 43/43, Latin, Cyrillic, Lari sign. Has NO Mtavruli glyphs, so never uppercase Georgian. Noto Sans Georgian is the system fallback (Android ships it)."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
        "$description": "Codes only (2FA code entry, promo codes, IBAN). Digits and Latin only."
      }
    },
    "native": {
      "$description": "React Native cannot synthesize weights from one family name reliably on Android, so each weight is its own loaded font. Keys are CSS weights; values are the names passed to expo-font useFonts().",
      "family": {
        "$type": "string",
        "400": { "$value": "FiraGO-Regular" },
        "500": { "$value": "FiraGO-Medium" },
        "600": { "$value": "FiraGO-SemiBold" },
        "700": { "$value": "FiraGO-Bold" }
      },
      "files": {
        "$type": "string",
        "$description": "Paths relative to packages/assets.",
        "400": { "$value": "fonts/ttf/FiraGO-Regular.ttf" },
        "500": { "$value": "fonts/ttf/FiraGO-Medium.ttf" },
        "600": { "$value": "fonts/ttf/FiraGO-SemiBold.ttf" },
        "700": { "$value": "fonts/ttf/FiraGO-Bold.ttf" }
      }
    },
    "webFiles": {
      "$type": "string",
      "$description": "woff2 files for @font-face, relative to packages/assets. One family name 'FiraGO' with real weights (fixes the legacy 'FiraGo Bold' faux-bold bug).",
      "400": { "$value": "fonts/woff2/FiraGO-Regular.woff2" },
      "500": { "$value": "fonts/woff2/FiraGO-Medium.woff2" },
      "600": { "$value": "fonts/woff2/FiraGO-SemiBold.woff2" },
      "700": { "$value": "fonts/woff2/FiraGO-Bold.woff2" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "The only font sizes allowed. 13 is the absolute minimum (captions, badges, timestamps). Body text is 16. Inputs are always >= 16 (prevents iOS zoom on focus).",
      "xs":  { "$value": 13 },
      "sm":  { "$value": 14 },
      "md":  { "$value": 16 },
      "lg":  { "$value": 18 },
      "xl":  { "$value": 20 },
      "2xl": { "$value": 24 },
      "3xl": { "$value": 28 },
      "4xl": { "$value": 32 },
      "5xl": { "$value": 40 }
    },
    "lineHeight": {
      "$type": "dimension",
      "$description": "Absolute px line heights (React Native needs absolute values). Body text >= 1.5x for Mkhedruli ascenders/descenders.",
      "xs":  { "$value": 20 },
      "sm":  { "$value": 22 },
      "md":  { "$value": 24 },
      "lg":  { "$value": 28 },
      "xl":  { "$value": 28 },
      "2xl": { "$value": 32 },
      "3xl": { "$value": 36 },
      "4xl": { "$value": 40 },
      "5xl": { "$value": 48 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "normal": { "$value": 0, "$description": "Always 0. No tracking-wide/widest on Georgian (legacy 'no rating' label, section titles)." }
    },
    "textTransform": {
      "$type": "string",
      "none": { "$value": "none", "$description": "The only allowed value. Uppercase Georgian becomes Mtavruli, which FiraGO does not have (audit 0.3)." }
    },
    "numeric": {
      "$type": "string",
      "tabular": { "$value": "tabular-nums", "$description": "CSS font-variant-numeric / RN fontVariant ['tabular-nums']. Used for prices, balances, counters, tables." }
    }
  },

  "text": {
    "$type": "typography",
    "$description": "Composite text styles. $value is the mobile/base style. $extensions['ge.mytask.lg'] overrides size/line height from breakpoint.lg (1024) up on web. React Native uses $value only.",
    "display":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.3xl}", "lineHeight": "{font.lineHeight.3xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$extensions": { "ge.mytask.lg": { "fontSize": "{font.size.5xl}", "lineHeight": "{font.lineHeight.5xl}" } }, "$description": "Home hero h1 only." },
    "h1":       { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xl}", "lineHeight": "{font.lineHeight.2xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$extensions": { "ge.mytask.lg": { "fontSize": "{font.size.4xl}", "lineHeight": "{font.lineHeight.4xl}" } }, "$description": "Page title (gig title, project title, profile name). One per page." },
    "h2":       { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xl}", "lineHeight": "{font.lineHeight.xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$extensions": { "ge.mytask.lg": { "fontSize": "{font.size.2xl}", "lineHeight": "{font.lineHeight.2xl}" } }, "$description": "Section title (home rows, 'Project details', 'About me')." },
    "h3":       { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "lineHeight": "{font.lineHeight.lg}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$extensions": { "ge.mytask.lg": { "fontSize": "{font.size.xl}", "lineHeight": "{font.lineHeight.xl}" } }, "$description": "Card group / panel title, modal title." },
    "title":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "lineHeight": "{font.lineHeight.md}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Card titles (gig card, project row), list item titles. Clamp by line count (2), never by fixed height." },
    "bodyLg":   { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "lineHeight": "{font.lineHeight.lg}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Long-form reading (CMS pages, gig description on desktop)." },
    "body":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "lineHeight": "{font.lineHeight.md}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Default text. Minimum size for running text and inputs." },
    "bodySm":   { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "lineHeight": "{font.lineHeight.sm}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Secondary text: meta rows, help text, table cells, nav links." },
    "label":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "lineHeight": "{font.lineHeight.sm}", "fontWeight": "{font.weight.medium}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Form labels, tab labels, segmented control. Never truncated." },
    "caption":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "lineHeight": "{font.lineHeight.xs}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Timestamps, counters, legal fine print. Smallest allowed." },
    "badge":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "lineHeight": "{font.lineHeight.xs}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Badges, pills, status chips." },
    "eyebrow":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "lineHeight": "{font.lineHeight.sm}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Replaces legacy 'uppercase tracking-wider' section labels: colour + weight instead of case." },
    "buttonSm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "lineHeight": "{font.lineHeight.sm}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letterSpacing.normal}" } },
    "buttonMd": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "lineHeight": "{font.lineHeight.md}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letterSpacing.normal}" } },
    "price":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "lineHeight": "{font.lineHeight.lg}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$description": "Card prices. Always tabular numerals." },
    "priceLg":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xl}", "lineHeight": "{font.lineHeight.2xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.letterSpacing.normal}" }, "$extensions": { "ge.mytask.lg": { "fontSize": "{font.size.4xl}", "lineHeight": "{font.lineHeight.4xl}" } }, "$description": "Purchase box price, balance tiles, checkout total, plan price." }
  },

  "space": {
    "$type": "dimension",
    "$description": "4 px grid. Keys follow the Tailwind numbering the legacy code already uses (4 = 16 px). Off-grid legacy values (4.5, 2.5, 1.5, 3.5, [7px], [9px]) are retired.",
    "0":   { "$value": 0 },
    "0.5": { "$value": 2, "$description": "Hairline gaps only (icon + counter)." },
    "1":   { "$value": 4 },
    "2":   { "$value": 8 },
    "3":   { "$value": 12 },
    "4":   { "$value": 16 },
    "5":   { "$value": 20 },
    "6":   { "$value": 24 },
    "8":   { "$value": 32 },
    "10":  { "$value": 40 },
    "12":  { "$value": 48 },
    "16":  { "$value": 64 },
    "20":  { "$value": 80 },
    "24":  { "$value": 96 }
  },

  "radius": {
    "$type": "dimension",
    "$description": "One radius per role (audit 1.7: four button shapes today).",
    "none":    { "$value": 0 },
    "xs":      { "$value": 4, "$description": "Checkbox, tiny tags, image thumbnails in tables." },
    "sm":      { "$value": 6, "$description": "Tooltip, menu items, chips inside inputs." },
    "md":      { "$value": 8, "$description": "Controls: buttons, inputs, selects, segmented control, tabs pill." },
    "lg":      { "$value": 12, "$description": "Cards (gig, project, profile, KPI), panels, dropdown menus, toasts, banners." },
    "xl":      { "$value": 16, "$description": "Dialogs, bottom sheets (top corners), chat bubbles, hero search." },
    "2xl":     { "$value": 24, "$description": "Home hero tiles, plan cards (legacy 1.5rem kept)." },
    "full":    { "$value": 9999, "$description": "Avatars, pills/badges, online dot, switch, favourite button." },
    "control": { "$value": "{radius.md}" },
    "card":    { "$value": "{radius.lg}" },
    "dialog":  { "$value": "{radius.xl}" },
    "pill":    { "$value": "{radius.full}" }
  },

  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": 1 },
    "strong":   { "$value": 2, "$description": "Selected card, Premium/Featured frame, active tab indicator." }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Three elevation levels + none. Values are per theme under theme.<name>.shadow (dark needs stronger shadows plus a border). Primitive definitions here; $extensions['ge.mytask.native'] gives the React Native / Android equivalents.",
    "none": { "$value": [] },
    "sm": {
      "$value": [
        { "color": "#1616160F", "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0 },
        { "color": "#1616161A", "offsetX": 0, "offsetY": 1, "blur": 3, "spread": 0 }
      ],
      "$extensions": { "ge.mytask.native": { "shadowColor": "#161616", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.1, "shadowRadius": 3, "elevation": 1 } },
      "$description": "Level 1: resting cards (legacy shadow-sm ring-1)."
    },
    "md": {
      "$value": [
        { "color": "#16161614", "offsetX": 0, "offsetY": 4, "blur": 12, "spread": -4 },
        { "color": "#1616160F", "offsetX": 0, "offsetY": 2, "blur": 4, "spread": 0 }
      ],
      "$extensions": { "ge.mytask.native": { "shadowColor": "#161616", "shadowOffset": { "width": 0, "height": 4 }, "shadowOpacity": 0.12, "shadowRadius": 8, "elevation": 4 } },
      "$description": "Level 2: hovered cards, dropdown menus, sticky bars, popovers (legacy plan card)."
    },
    "lg": {
      "$value": [
        { "color": "#16161633", "offsetX": 0, "offsetY": 24, "blur": 48, "spread": -12 }
      ],
      "$extensions": { "ge.mytask.native": { "shadowColor": "#161616", "shadowOffset": { "width": 0, "height": 12 }, "shadowOpacity": 0.2, "shadowRadius": 24, "elevation": 12 } },
      "$description": "Level 3: dialogs, bottom sheets, toasts."
    },
    "smDark": {
      "$value": [ { "color": "#00000066", "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0 } ],
      "$extensions": { "ge.mytask.native": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.4, "shadowRadius": 2, "elevation": 1 } }
    },
    "mdDark": {
      "$value": [ { "color": "#00000080", "offsetX": 0, "offsetY": 4, "blur": 12, "spread": -2 } ],
      "$extensions": { "ge.mytask.native": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 4 }, "shadowOpacity": 0.5, "shadowRadius": 8, "elevation": 4 } }
    },
    "lgDark": {
      "$value": [ { "color": "#000000A6", "offsetX": 0, "offsetY": 24, "blur": 48, "spread": -8 } ],
      "$extensions": { "ge.mytask.native": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 12 }, "shadowOpacity": 0.65, "shadowRadius": 24, "elevation": 12 } }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Min-width breakpoints (web). Same numbers as legacy Tailwind sm/md/lg/xl; legacy '1xl' 1440 kept as 2xl, legacy 2xl 1536 and the chat/pricing/toastr ad-hoc breakpoints (576/680/700/720/767/980/1060) are retired. Mobile app: 'compact' < md, 'medium' md..lg (tablets), 'expanded' >= lg.",
    "sm":  { "$value": 640 },
    "md":  { "$value": 768, "$description": "Dashboard sidebar appears; tables stop being card lists." },
    "lg":  { "$value": 1024, "$description": "Desktop header (hamburger hidden), two-column gig/project pages, type steps up." },
    "xl":  { "$value": 1280 },
    "2xl": { "$value": 1440 }
  },

  "size": {
    "$type": "dimension",
    "touchTarget": {
      "min":    { "$value": 44, "$description": "Minimum hit area for every interactive element, web and mobile (WCAG 2.5.5 AAA / Apple HIG). Small visuals (checkbox 20, favourite icon 20) get padding or an invisible hit area to reach 44x44." },
      "comfortable": { "$value": 48, "$description": "Preferred on Android and for primary mobile actions." }
    },
    "control": {
      "sm": { "$value": 36, "$description": "Web desktop dense areas only (tables, filters). Hit area still extended to 44 on touch (pointer: coarse)." },
      "md": { "$value": 44, "$description": "Default for buttons, inputs, selects, tabs." },
      "lg": { "$value": 52, "$description": "Primary CTAs: Add to cart, Confirm, auth submit, sticky bars, hero search." }
    },
    "icon": {
      "xs": { "$value": 16 },
      "sm": { "$value": 20, "$description": "Default in buttons, inputs, menus, meta rows." },
      "md": { "$value": 24, "$description": "Default standalone (header, tab bar, icon buttons)." },
      "lg": { "$value": 32 },
      "xl": { "$value": 48, "$description": "Empty-state and result icons." }
    },
    "avatar": {
