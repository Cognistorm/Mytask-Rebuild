{
  "name": "@mytask/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI strings (ka default, en) for web, admin and mobile. Flat t_* keys, i18next syntax (ADR-006 §3).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ka.json": "./ka.json",
    "./en.json": "./en.json"
  },
  "scripts": {
    "import:legacy": "node scripts/import-legacy.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@mytask/config": "workspace:*",
    "eslint": "10.11.0",
    "typescript": "5.9.3"
  }
}
