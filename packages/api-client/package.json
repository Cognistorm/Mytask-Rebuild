{
  "name": "@mytask/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed client for the MyTask.ge API: openapi-fetch typed by @mytask/types + a thin wrapper for cross-cutting headers only (ADR-014 §2). No business logic.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mytask/types": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@mytask/config": "workspace:*",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "yaml": "2.8.1"
  }
}
